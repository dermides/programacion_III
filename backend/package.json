    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
